{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true, "skipLibCheck": true,
    "noEmit": true, "forceConsistentCasingInFileNames": true, "esModuleInterop": true,
    "jsx": "react-jsx", "noUnusedLocals": false, "noUnusedParameters": false,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts", "playwright.config.ts"]
}
