# MongoDB host and database name; use service name mongodb in Compose.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ketsip
# Replace with an independently generated secret of at least 32 characters.
JWT_SECRET=
# Initial local demo password; set before starting with seeding enabled.
SEED_PASSWORD=
SEED_ON_STARTUP=true
CORS_ORIGINS=http://localhost:5173
JWT_EXPIRY_MINUTES=480
